# Application
APP_NAME=enterprise-claude-rag-boilerplate
APP_ENV=development
APP_DEBUG=true
API_V1_PREFIX=/api/v1
CORS_ORIGINS=["http://localhost:3000","http://localhost:8000"]
LOG_LEVEL=INFO
LOG_JSON=true

# AWS / Bedrock
AWS_REGION=us-east-1
AWS_ACCESS_KEY_ID=your-access-key-id
AWS_SECRET_ACCESS_KEY=your-secret-access-key
# Optional: use a named profile instead of static keys (local only)
# AWS_PROFILE=default
BEDROCK_MODEL_ID=anthropic.claude-3-sonnet-20240229-v1:0
BEDROCK_EMBEDDING_MODEL_ID=amazon.titan-embed-text-v2:0
BEDROCK_MAX_TOKENS=4096
BEDROCK_TEMPERATURE=0.7
BEDROCK_TOP_P=0.9

# Claude system prompt (optional override)
CLAUDE_SYSTEM_PROMPT=You are a helpful enterprise assistant. Answer accurately and cite context when available.

# PostgreSQL + pgvector
# Use the SQLAlchemy async URL form (asyncpg driver)
DATABASE_URL=postgresql+asyncpg://rag:rag@localhost:5432/rag
PGVECTOR_TABLE=documents
PGVECTOR_EMBEDDING_DIM=1024
PGVECTOR_DISTANCE=cosine
RAG_ENGINE=mock
# Set RAG_ENGINE=pgvector once PostgreSQL + pgvector is available (see app/db/schema.sql)
RAG_TOP_K=5

# OpenTelemetry (set OTEL_SDK_DISABLED=true for local tests without a collector)
OTEL_SERVICE_NAME=enterprise-claude-rag-boilerplate
OTEL_EXPORTER_OTLP_ENDPOINT=http://localhost:4317
OTEL_TRACES_EXPORTER=otlp
OTEL_SDK_DISABLED=false
